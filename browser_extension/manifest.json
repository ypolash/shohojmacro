{
  "manifest_version": 3,
  "name": "Shohoj Browser Companion",
  "version": "1.0.0",
  "description": "Stealth DOM Inspector & Coordinate Bridge for Shohoj Macro by Polash Khan (ypolash2)",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shohoj Browser Companion"
  }
}
